# ─── Variables de entorno — NUNCA subir al repositorio ────────────────────────
.env
.env.*
!.env.example

# ─── Python ───────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
.Python
*.egg
*.egg-info/
dist/
build/
eggs/
parts/
var/
sdist/
develop-eggs/
.installed.cfg
lib/
lib64/
*.manifest
*.spec

# ─── Entornos virtuales ────────────────────────────────────────────────────────
venv/
env/
.venv/
ENV/
env.bak/
venv.bak/

# ─── Alembic ──────────────────────────────────────────────────────────────────
# Mantener las migraciones pero ignorar caché
alembic/__pycache__/

# ─── Testing ──────────────────────────────────────────────────────────────────
.pytest_cache/
.coverage
htmlcov/
.tox/
nosetests.xml
coverage.xml
*.cover

# ─── IDEs ─────────────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo

# ─── Docker ───────────────────────────────────────────────────────────────────
# No ignorar Dockerfile ni docker-compose — son parte del proyecto

# ─── Archivos locales / temporales ────────────────────────────────────────────
scratch/
*.log
*.tmp
.DS_Store
Thumbs.db

# ─── Claves y certificados ────────────────────────────────────────────────────
*.pem
*.key
*.cert
*.p12
credentials.json
token.json
