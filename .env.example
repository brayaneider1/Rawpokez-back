# ─── INSTRUCCIONES ────────────────────────────────────────────────────────────
# 1. Copia este archivo: cp .env.example .env
# 2. Rellena CADA variable con tus valores reales
# 3. NUNCA subas el archivo .env al repositorio
# ──────────────────────────────────────────────────────────────────────────────

# ─── Database ─────────────────────────────────────────────────────────────────
# En producción (Azure): Obtener la URL del Azure Key Vault
# En local: usar el contenedor Docker de PostgreSQL
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:5432/DB_NAME
DATABASE_URL_SYNC=postgresql+psycopg2://USER:PASSWORD@HOST:5432/DB_NAME

# ─── App ──────────────────────────────────────────────────────────────────────
APP_ENV=development
APP_SECRET_KEY=CHANGE_ME_IN_PRODUCTION_MIN_32_CHARS
ALLOWED_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000

# ─── Azure Key Vault ──────────────────────────────────────────────────────────
# En LOCAL: dejar vacío. Se usará el .env directamente.
# En PRODUCCIÓN (Azure App Service): poner la URL del Key Vault.
# Formato: https://<nombre-del-vault>.vault.azure.net/
AZURE_KEY_VAULT_URL=

# ─── Cloudinary (subida de imágenes) ─────────────────────────────────────────
# Obtener en: https://cloudinary.com → Dashboard
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ─── Google Calendar ──────────────────────────────────────────────────────────
# Obtener en: https://console.cloud.google.com → Credentials
GOOGLE_CLIENT_ID=your_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_client_secret
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback
GOOGLE_CALENDAR_ID=primary

# ─── WhatsApp microservice ────────────────────────────────────────────────────
WHATSAPP_SERVICE_URL=http://whatsapp:3001
MARIA_PHONE=+57XXXXXXXXXX

# ─── Telegram Bot ─────────────────────────────────────────────────────────────
# 1. Crear bot con @BotFather en Telegram
# 2. Obtener TELEGRAM_BOT_TOKEN del BotFather
# 3. Obtener TELEGRAM_CHAT_ID con: https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=1234567890:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TELEGRAM_CHAT_ID=0000000000

# ─── Admin Panel ──────────────────────────────────────────────────────────────
ADMIN_USERNAME=maria
ADMIN_PASSWORD=CHANGE_ME_IN_PRODUCTION

# ─── Gemini AI ────────────────────────────────────────────────────────────────
# Obtener en: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIzaSyXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# ─── MercadoPago ──────────────────────────────────────────────────────────────
# Sandbox: empieza con TEST-... | Producción: empieza con APP_USR-...
# Obtener en: https://www.mercadopago.com.co/developers
MP_ACCESS_TOKEN=TEST-REEMPLAZAR_CON_TU_TOKEN

# ─── Web Push VAPID ───────────────────────────────────────────────────────────
# Generar con: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=BXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
VAPID_PRIVATE_KEY=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
VAPID_CLAIM_EMAIL=tu_email@ejemplo.com
